# VHS Tape: Episode 7 - The Executive Cockpit: Measuring Data ROI & Strategy
# Lead Persona: Jules Keeper & Reggie Mint (juleskeeper)
# Output: 1080p TrueColor MP4 Terminal Walkthrough

Output "/Users/petercoldicott/PycharmProjects/egeria/egeria-workspaces/egeria-python/my_egeria/my_egeria/recording/output/episode7/videos/episode_7_walkthrough.mp4"

Set Shell "bash"
Set FontSize 18
Set FontFamily "Menlo"
Set Width 1920
Set Height 1080
Set Padding 20
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"
Set WindowBarSize 40
Set MarginFill "#1e1e2e"
Set BorderRadius 10
Set TypingSpeed 50ms

Type "unset NO_COLOR && export COLORTERM=truecolor TERM=xterm-256color FORCE_COLOR=1 EGERIA_USER=juleskeeper && clear"
Enter
Sleep 500ms

# Launch My Profile as juleskeeper
Type "uv run my_profile"
Enter
Sleep 3.5s

# Welcome Splash Screen (Jules Keeper - Chief Data Officer)
Sleep 6s

# Dismiss Splash Screen into Main Dashboard
Enter
Sleep 3.5s

# Scene 2: Executive Cockpit Walkthrough & Portfolio Health
Tab 1
Sleep 2s
Down 2
Sleep 3s

# Scene 3: CFO Perspective - Quantifying Data ROI & Risk Reduction
Tab 3
Down 9
Sleep 1s
Enter
Sleep 3s
Escape
Sleep 2s

# Scene 4: Community Engagement & Collaborative Governance
Tab 3
Down 2
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 2s
Tab 3
Down 3
Sleep 1s
Enter
Sleep 3s
Escape
Sleep 3s
