# VHS Tape: Episode 6 - Forensic Data Auditing & Fraud Investigation
# Lead Persona: Sidney Seeker (sidneyseeker)
# Output: 1080p TrueColor MP4 Terminal Walkthrough

Output "/Users/petercoldicott/PycharmProjects/egeria/egeria-workspaces/egeria-python/my_egeria/my_egeria/recording/output/episode6/videos/episode_6_walkthrough.mp4"

Set Shell "bash"
Set FontSize 18
Set FontFamily "Menlo"
Set Width 1920
Set Height 1080
Set Padding 20
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"
Set WindowBarSize 40
Set MarginFill "#1e1e2e"
Set BorderRadius 10
Set TypingSpeed 50ms

Type "unset NO_COLOR && export COLORTERM=truecolor TERM=xterm-256color FORCE_COLOR=1 EGERIA_USER=sidneyseeker && clear"
Enter
Sleep 500ms

# Launch My Profile as sidneyseeker
Type "uv run my_profile"
Enter
Sleep 3.5s

# Welcome Splash Screen (Sidney Seeker - Lead Fraud Investigator)
Sleep 6s

# Dismiss Splash Screen into Main Dashboard
Enter
Sleep 3.5s

# Scene 2: Investigator Workspace & Security Team Drill-Down
Tab 1
Sleep 2s
Down 2
Sleep 3s

# Scene 3: Tracing Payment Anomalies with Lineage & Comments
Ctrl+O
Sleep 4s
Escape
Sleep 2s
Tab 4
Ctrl+T
Sleep 3s
Escape
Sleep 2s

# Scene 4: Uncovering Shadow IT in the Network Graph
Tab 3
Down 1
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 3s
