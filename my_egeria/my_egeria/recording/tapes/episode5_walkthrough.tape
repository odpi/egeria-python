# VHS Tape: Episode 5 - Connecting Business Glossaries to Technical Architecture
# Lead Persona: Erin Overview (erinoverview)
# Output: 1080p TrueColor MP4 Terminal Walkthrough

Output "/Users/petercoldicott/PycharmProjects/egeria/egeria-workspaces/egeria-python/my_egeria/my_egeria/recording/output/episode5/videos/episode_5_walkthrough.mp4"

Set Shell "bash"
Set FontSize 18
Set FontFamily "Menlo"
Set Width 1920
Set Height 1080
Set Padding 20
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"
Set WindowBarSize 40
Set MarginFill "#1e1e2e"
Set BorderRadius 10
Set TypingSpeed 50ms

Type "unset NO_COLOR && export COLORTERM=truecolor TERM=xterm-256color FORCE_COLOR=1 EGERIA_USER=erinoverview && clear"
Enter
Sleep 500ms

# Launch My Profile as erinoverview
Type "uv run my_profile"
Enter
Sleep 3.5s

# Welcome Splash Screen (Erin Overview - Enterprise Information Architect)
Sleep 6s

# Dismiss Splash Screen into Main Dashboard
Enter
Sleep 3.5s

# Scene 2: Architecture Cockpit & Communities Navigation
Tab 3
Down 2
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 2s

# Scene 3: Browsing Unified Glossary & Term Dictionaries
Tab 3
Down 6
Sleep 1s
Enter
Sleep 4s
Type "Architecture"
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 2s

# Scene 4: Graph Visualization of Architectural Dependencies
Tab 3
Down 1
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 3s
