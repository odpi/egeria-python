# VHS Tape: Episode 2 - Zero-Touch Data Stewardship & Curation at Scale
# Lead Persona: Peter Profile (peterprofile)
# Output: 1080p TrueColor MP4 Terminal Walkthrough

Output "/Users/petercoldicott/PycharmProjects/egeria/egeria-workspaces/egeria-python/my_egeria/my_egeria/recording/output/episode2/videos/episode_2_walkthrough.mp4"

Set Shell "bash"
Set FontSize 18
Set FontFamily "Menlo"
Set Width 1920
Set Height 1080
Set Padding 20
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"
Set WindowBarSize 40
Set MarginFill "#1e1e2e"
Set BorderRadius 10
Set TypingSpeed 50ms

Type "unset NO_COLOR && export COLORTERM=truecolor TERM=xterm-256color FORCE_COLOR=1 EGERIA_USER=peterprofile && clear"
Enter
Sleep 500ms

# Launch My Profile as peterprofile
Type "uv run my_profile"
Enter
Sleep 3.5s

# Welcome Splash Screen (Peter Profile - Lead Data Steward)
Sleep 6s

# Dismiss Splash Screen into Main Dashboard
Enter
Sleep 3.5s

# Scene 2: Managing Curation To-Dos
Tab 4
Sleep 1.5s
Ctrl+T
Sleep 4s
Down 2
Sleep 2s
Escape
Sleep 2s

# Scene 3: Real-Time Annotation & Discussion Threads
Ctrl+O
Sleep 4s
Ctrl+N
Sleep 3s
Type "Verified ISO 27001 mapping for clinical trial schemas"
Sleep 2s
Escape
Sleep 2s
Escape
Sleep 2s

# Scene 4: Earning Karma Points & Community Leadership
Ctrl+B
Sleep 4s
Escape
Sleep 2s
Tab 1
Sleep 2s
Down 1
Sleep 4s
