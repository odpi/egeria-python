# VHS Tape: Episode 1 - Automating Data Privacy & GDPR Compliance
# Lead Persona: Faith Broker (faithbroker)
# Output: 1080p TrueColor MP4 Terminal Walkthrough

Output "/Users/petercoldicott/PycharmProjects/egeria/egeria-workspaces/egeria-python/my_egeria/my_egeria/recording/output/episode1/videos/episode_1_walkthrough.mp4"

Set Shell "bash"
Set FontSize 18
Set FontFamily "Menlo"
Set Width 1920
Set Height 1080
Set Padding 20
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"
Set WindowBarSize 40
Set MarginFill "#1e1e2e"
Set BorderRadius 10
Set TypingSpeed 50ms

Type "unset NO_COLOR && export COLORTERM=truecolor TERM=xterm-256color FORCE_COLOR=1 EGERIA_USER=faithbroker && clear"
Enter
Sleep 500ms

# Launch My Profile as faithbroker
Type "uv run my_profile"
Enter
Sleep 3.5s

# Welcome Splash Screen (Faith Broker - HR & Data Privacy Officer)
Sleep 7s

# Dismiss Splash Screen into Main Dashboard
Enter
Sleep 3.5s

# Scene 2: Privacy Role & Team Hierarchy
# Focus on Governance Council and HR Leadership
Tab 1
Sleep 2s
Down 2
Sleep 2s
Enter
Sleep 4s
Escape
Sleep 2s

# Scene 3: Subject Access Request (SAR) & PII Lineage
# Select Catalogs / Shop for Data from Other Functions
Tab 3
Down 6
Sleep 1s
Enter
Sleep 4s
Type "Clinical"
Sleep 1s
Enter
Sleep 3s
Escape
Sleep 2s

# Navigate to My Network Graph
Tab 3
Down 1
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 2s

# Scene 4: Real-Time Privacy Stewardship & Feedback
# Open Leave Feedback modal
Tab 3
Down 3
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 2s

# Focus on To-Dos table
Tab 4
Ctrl+T
Sleep 3s
Escape
Sleep 4s
