# VHS Tape: Episode 4 - Supply Chain Traceability & ESG Sustainability
# Lead Persona: Stew Faster (stewfaster)
# Output: 1080p TrueColor MP4 Terminal Walkthrough

Output "/Users/petercoldicott/PycharmProjects/egeria/egeria-workspaces/egeria-python/my_egeria/my_egeria/recording/output/episode4/videos/episode_4_walkthrough.mp4"

Set Shell "bash"
Set FontSize 18
Set FontFamily "Menlo"
Set Width 1920
Set Height 1080
Set Padding 20
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"
Set WindowBarSize 40
Set MarginFill "#1e1e2e"
Set BorderRadius 10
Set TypingSpeed 50ms

Type "unset NO_COLOR && export COLORTERM=truecolor TERM=xterm-256color FORCE_COLOR=1 EGERIA_USER=stewfaster && clear"
Enter
Sleep 500ms

# Launch My Profile as stewfaster
Type "uv run my_profile"
Enter
Sleep 3.5s

# Welcome Splash Screen (Stew Faster - Manufacturing General Manager)
Sleep 5s

# Dismiss Splash Screen into Main Dashboard
Enter
Sleep 3.5s

# Scene 2: Plant Manager Dashboard & Roles
Tab 1
Sleep 2s
Down 2
Sleep 3s

# Scene 3: Exploring Technology Types & Factory Catalogs
Tab 3
Down 7
Sleep 1s
Enter
Sleep 5s
Down 2
Sleep 2s
Up 1
Sleep 2s
Escape
Sleep 2s

# Scene 4: Collaborative Operational Feedback & Actions
Tab 3
Down 3
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 3s
