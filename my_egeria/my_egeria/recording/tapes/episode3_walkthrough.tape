# VHS Tape: Episode 3 - Trusted Clinical Data Provenance & Trial Integrity
# Lead Persona: Dr. Tessa Tube (tessatube)
# Output: 1080p TrueColor MP4 Terminal Walkthrough

Output "/Users/petercoldicott/PycharmProjects/egeria/egeria-workspaces/egeria-python/my_egeria/my_egeria/recording/output/episode3/videos/episode_3_walkthrough.mp4"

Set Shell "bash"
Set FontSize 18
Set FontFamily "Menlo"
Set Width 1920
Set Height 1080
Set Padding 20
Set Theme "Catppuccin Mocha"
Set WindowBar "Colorful"
Set WindowBarSize 40
Set MarginFill "#1e1e2e"
Set BorderRadius 10
Set TypingSpeed 50ms

Type "unset NO_COLOR && export COLORTERM=truecolor TERM=xterm-256color FORCE_COLOR=1 EGERIA_USER=tessatube && clear"
Enter
Sleep 500ms

# Launch My Profile as tessatube
Type "uv run my_profile"
Enter
Sleep 3.5s

# Welcome Splash Screen (Dr. Tessa Tube - Lead Clinical Researcher)
Sleep 7s

# Dismiss Splash Screen into Main Dashboard
Enter
Sleep 3.5s

# Scene 2: Shopping for Certified Clinical Data Products
Tab 3
Down 6
Sleep 1s
Enter
Sleep 4s
Type "Cohort"
Sleep 1s
Enter
Sleep 4s

# Scene 3: Governed Subscription Requests & Usage Terms
Ctrl+L
Sleep 4s
Escape
Sleep 2s
Ctrl+U
Sleep 4s
Escape
Sleep 2s
Escape
Sleep 2s

# Scene 4: Cross-Functional Research Collaboration
Tab 3
Down 2
Sleep 1s
Enter
Sleep 4s
Escape
Sleep 4s
