/*                                                                                                 */
/*   This file provides a set of report specification related functions for my_egeria.             */
/*                                                                                                 */
/*    Unless you are running Microsoft's Studio Product with the Textual Extension installed       */
/*    the file will show multiple errors, for example I use the PyCharm IDE for which there are    */
/*    no extensions for Textual, regardless of the errors the file will run correctly with Textual.*/
/* *********************************************************************************************** */

Screen {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    background: #1e1e2e;
    color: #cdd6f4;
}

#main_screen {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    /*grid-rows: 3 1fr 1fr 1fr 1;*/
    grid-rows: 1fr 1fr 1fr;
    grid-gutter: 1;
    background: #1e1e2e;
}

#main_header {
    column-span: 3;
    height: 3;
    width: 100%;
    background: #11111b;
    color: #89b4fa;
}

#main_footer {
    column-span: 3;
    height: 1;
    width: 100%;
    background: #11111b;
    color: #cdd6f4;
}

ModalScreen {
    layout: grid;
    grid-size: 3;
    grid-rows: auto;
    outline: chartreuse;
    grid-gutter: 2;
}

.EditProfileScreen {
    grid-rows: auto auto 1fr auto;
}

.EditTeamsScreen {
    grid-rows: auto auto auto 1fr auto;
}

.EditRolesScreen, .EditCommunitiesScreen, .EditIdentitiesScreen,.StatusScreen, .GenericDataViewScreen {
    grid-rows: auto auto 1fr auto;
}

/* Header and Footer are docked, so the grid holds only the title and the container */
FeedbackScreen, FeedbackLogScreen {
    grid-rows: auto 1fr;
    background: $background;
}

/* Title row, then network + search side by side, then the selected peer's details */
MyNetworkScreen {
    grid-rows: auto 1fr 1fr;
    background: $background;
}

#my_network_container {
    column-span: 2;
    width: 100%;
    height: 100%;
    border: round #89b4fa;
    background: #181825;
    padding: 0 1;
}

#people_search_container {
    width: 100%;
    height: 100%;
    border: round #89b4fa;
    background: #181825;
    padding: 0 1;
}

#peer_details_container {
    column-span: 3;
    width: 100%;
    height: 100%;
    border: round #89b4fa;
    background: #181825;
    padding: 0 1;
}

#my_network_table {
    width: 100%;
    height: 1fr;
}

#my_network_buttons,
#add_peer_container,
#add_peer_container Horizontal {
    height: auto;
}

#people_found_table,
#peer_contacts_table,
#peer_communities_table {
    height: auto;
    max-height: 12;
}

/* Title row, then my communities + find side by side */
CommunitiesScreen {
    grid-rows: auto 1fr;
    background: $background;
}

#my_communities_container {
    column-span: 2;
    width: 100%;
    height: 100%;
}

#find_communities_container {
    width: 100%;
    height: 100%;
}

#my_communities_table {
    width: 100%;
    height: 1fr;
}

#my_communities_buttons,
#found_communities_buttons {
    height: auto;
}

#join_assignment_type, #creator_assignment_type {
    width: 20;
}

#communities_found_table {
    height: auto;
    max-height: 12;
}

/* Title row, then the blog + members side by side, then the resources + comments */
CommunityScreen {
    grid-rows: auto 1fr 1fr;
    background: $background;
}

#community_blog_container {
    column-span: 2;
    width: 100%;
    height: 100%;
}

#community_members_container {
    width: 100%;
    height: 100%;
}

#community_resources_container {
    column-span: 2;
    width: 100%;
    height: 100%;
}

#community_comments_container {
    width: 100%;
    height: 100%;
}

#community_posts_table,
#community_members_table,
#community_resources_table,
#community_comments_table {
    height: auto;
    max-height: 12;
}

#community_blog_buttons,
#community_join_controls {
    height: auto;
}

#community_join_assignment_type {
    width: 20;
}

/* Title row, the like/rating summary, then the ratings + comments side by side */
ElementFeedbackScreen {
    grid-rows: auto auto 1fr;
    background: $background;
}

#feedback_summary_container {
    column-span: 3;
    height: auto;
}

#feedback_buttons {
    height: auto;
}

#element_ratings_container {
    width: 100%;
    height: 100%;
}

#element_comments_container {
    column-span: 2;
    width: 100%;
    height: 100%;
}

#element_ratings_table,
#element_comments_table {
    height: auto;
    max-height: 16;
}

#community_post_text {
    padding: 1 0;
}

NewBlogPostScreen, AddCommunityCommentScreen, RateElementScreen {
    grid-rows: auto 1fr;
    background: $background;
}

#new_blog_post_container, #add_community_comment_container, #create_community_container, #rate_element_container {
    column-span: 3;
}

#new_blog_post_container Horizontal, #add_community_comment_container Horizontal, #create_community_container Horizontal, #rate_element_container Horizontal {
    height: auto;
}

#star_rating_select {
    width: 30;
}

#blog_post_text, #community_comment_text, #community_mission_text, #rating_review_text {
    height: 10;
}

ModalScreen > Header, ModalScreen > Footer {
    column-span: 3;
}

#communities_title, #community_title, #element_feedback_title, #rate_element_title, #new_blog_post_title, #add_community_comment_title, #create_community_title, #confirm_leave_community_title, #my_network_title, #confirm_remove_peer_title, #edit_profile_title, #create_profile_title, #edit_teams_title, #edit_roles_title, #edit_communities_title, #edit_identities_title, #status_title, #generic_data_view_title, #feedback_title, #feedback_log_title, .span-3 {
    column-span: 3;
    text-align: center;
    background: #89b4fa;
    color: #11111b;
    text-style: bold;
}

#main_projects_container,
#main_communities_container,
#main_roles_container,
#main_teams_container,
#other_function_container,
#other_function_list,
#main_associations_container,
#my_collections_container {
    width: 100%;
    height: 100%;
    border: round #89b4fa;
    background: #181825;
}

#main_activities_container {
    width: 100%;
    height: 100%;
    background: #181825;
}

#main_identities_container {
    column-span: 2;
    width: 100%;
    height: 100%;
    border: round #89b4fa;
    background: #181825;
}

#main_screen ScrollableContainer > Static {
    color: #89b4fa;
    text-style: bold;
}

#edit_roles_container,
#edit_communities_container,
#edit_identities_container,
#edit_teams_container,
#edit_associations_container,
#edit_blogs_container,
#edit_collections_container,
#edit_journal_container,
#edit_projects_container,
#edit_todos_container,
#confirm_delete_container,
#confirm_remove_peer_container,
#status_container,
#user_identities_container,
#generic_data_view_container,
#feedback_container,
#feedback_log_container {
    column-span: 2;
    width: 100%;
    height: 100%;
    border: round #89b4fa;
    background: #181825;
}

#technology_types_table,
#business_domain_table,
#communities_table,
#data_dictionary_table,
#data_specification_table,
#digital_product_catalog_table,
#glossary_table,
#generic_data_view_table,
#feedback_log_table,
#projects_table,
#roles_table,
#teams_table,
#user_identity_table,
#user_identity_datatable,
#status_table,
#root_collection_table,
#associations_destination,
#blogs_destination,
#collections_destination,
#communities_destination,
#identities_destination,
#journal_destination,
#projects_destination,
#roles_destination,
#teams_destination,
#todos_destination {
    width: 100%;
    height: 100%;
}

Button {
    background: #89b4fa;
    color: #11111b;
    border: none;
    text-style: bold;
}

Button:focus {
    background: #a6e3a1;
    color: #11111b;
}

Button:hover {
    background: #b4befe;
    color: #11111b;
}

DataTable, TextArea, SelectionList, Tree, OptionList {
    color: #cdd6f4;
    background: #181825;
}

DataTable {
    text-style: bold;
}

DataTable:focus {
    border: heavy #a6e3a1;
    background: #1e1e2e;
}
DataTable > .datatable--header {
    background: #313244;
    color: #89b4fa;
    text-style: bold;
}

DataTable > .datatable--cursor, OptionList > .option-list--cursor {
    background: #a6e3a1;
    color: #11111b;
    text-style: bold;
}

#edit_profile_form Horizontal {
    height: auto;
    width: 100%;
}

#blogs_table,
#journal_table,
#todos_table {
    width: 100%;
    height: 1fr;
}

#edit_profile_form Horizontal Static {
    width: 22;
}

#edit_profile_form Horizontal Input {
    width: 1fr;
}

Input {
    width: 1fr;
    height: auto;
    border: round #89b4fa;
    background: #11111b;
    color: #cdd6f4;
}

Input:focus {
    border: round #a6e3a1;
}

#show_comment_textarea_container,
#add_comment_textarea_container {
    width: 100%;
    height: 1fr;
    border: round #89b4fa;
    background: #181825;
}

#feedback_text {
    width: 100%;
    height: 10;
    border: round #89b4fa;
    background: #11111b;
    color: #cdd6f4;
}

#feedback_container Horizontal {
    height: auto;
}

.SplashScreen {
    align: center middle;              /* 1. Center the entire card on the screen */
    background: rgba(30, 30, 46, 0.7);    /* Dim the 3x3 grid behind it */
}

#splash-card {
    background: #181825;
    border: thick #89b4fa;
    padding: 2 4;
    width: 80;
    height: 24;
    /* 2. Vertically pushes layout content down and horizontally centers items */
    align: center bottom;
}

#splash-text {
    text-align: center;
    width: 100%;
    margin-bottom: 2;
    color: #cdd6f4;
}

#splash_buttons {
    layout: horizontal;
    align: center middle;
    height: auto;
    margin-bottom: 1;
}

#splash_buttons Button {
    margin: 0 1;                       /* Space out the two buttons side by side */
}

.empty {
    background: transparent; /* Invisible structural spacer */
}

ConnectionErrorScreen, ChangeUserScreen {
    align: center middle;
    background: rgba(30, 30, 46, 0.7);
}

#connection_error_card {
    background: #181825;
    border: thick #f38ba8;
    padding: 1 2;
    width: 90;
    height: auto;
}

#change_user_card {
    background: #181825;
    border: thick #89b4fa;
    padding: 1 2;
    width: 90;
    height: auto;
}
#connection_error_reason {
    color: $error;
    margin: 1 0;
}
#connection_retry_status {
    margin-bottom: 1;
}
#change_user_card Input {
    margin-top: 1;
}
#connection_error_buttons, #change_user_buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}
#connection_error_buttons Button, #change_user_buttons Button {
    margin: 0 1;
}
/* "Link to my profile" row on the Add screens: without these the label takes the
   full row width and the Switch is clipped off the right edge */
#add_input_container .link_row {
    height: auto;
}

#add_input_container .link_row Static {
    width: 1fr;
}

#add_input_container .link_row Switch {
    width: auto;
    border: solid white;
}
#add_input_container .link_row Switch > .switch--slider {
    color: grey;            /* off knob */
    background: cornsilk;   /* track */
}
#add_input_container .link_row Switch.-on > .switch--slider {
    color: chartreuse;      /* on knob */
}
